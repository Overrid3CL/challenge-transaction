# Copiar este archivo a .env y rellenar los valores antes de usar Docker o ejecutar la app.
# cp .env.example .env

# PostgreSQL (contenedor postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=transaction_db

# Conexión usada por ms-transaction (Spring Boot) y por Flyway en Gradle
DB_URL=jdbc:postgresql://localhost:5432/transaction_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Con Docker, el ms-transaction ignora DB_URL y usa siempre postgres:5432 (servicio).
# DB_USER/DB_PASSWORD en el MS se toman de POSTGRES_USER/POSTGRES_PASSWORD.

# URL del API para el frontend
VITE_API_URL=http://localhost:8080
